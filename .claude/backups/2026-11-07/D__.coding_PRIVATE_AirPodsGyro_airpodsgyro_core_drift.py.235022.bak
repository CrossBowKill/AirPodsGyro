"""Yaw-drift compensation for the AirPods' on-board attitude quaternion.

Measured on a Pro 3 (tools/soak-20261107-225643): with the head resting, the quaternion's heading
turns about the AirPods' world vertical at roughly +0.6..+3.7 deg/min (it varies minute to minute), and
the on-board fusion does not remove it. Pitch and roll stay referenced to gravity, so only heading is
corrected here.

Method (all in the AirPods' world frame, before the head-angle math):
  * Still detector: gyro magnitude below `still_dps` for `still_time_s`.
  * While still: any heading change is treated as drift and absorbed into an offset, limited to
    `cap_dpm` (deg/min). The cap sits above the worst measured drift but far below real head turns,
    so slow real motion is only nibbled at, never frozen.
  * The heading rate seen while still trains a slow estimate of the drift rate (`tau_s` seconds of
    still time). While moving, that estimated rate keeps being removed.
  * Output: q' = Rot(up, -offset) * q, i.e. the world frame is turned back by the accumulated drift.

The world vertical is learned from gravity (R * g_body). Recenter is independent of this module.
"""

import math

from . import headtrack as ht


def qmul(p, q):
    a, b, c, d = p
    e, f, g, h = q
    return (a * e - b * f - c * g - d * h, a * f + b * e + c * h - d * g,
            a * g - b * h + c * e + d * f, a * h + b * g - c * f + d * e)


def axis_quat(axis, deg):
    h = math.radians(deg) / 2
    s = math.sin(h)
    return (math.cos(h), axis[0] * s, axis[1] * s, axis[2] * s)


def twist_deg(q0, q1, up):
    """Rotation from q0 to q1 (both body -> world) about the world axis `up`, in degrees."""
    # world-frame delta: q1 * q0^-1
    w, x, y, z = qmul(q1, (q0[0], -q0[1], -q0[2], -q0[3]))
    if w < 0:
        w, x, y, z = -w, -x, -y, -z
    proj = x * up[0] + y * up[1] + z * up[2]
    return math.degrees(2.0 * math.atan2(proj, w))


class DriftCompensator:
    def __init__(self, enabled=True, still_dps=2.0, still_time_s=0.5, cap_dpm=6.0, tau_s=60.0):
        self.enabled = enabled
        self.still_dps, self.still_time_s = still_dps, still_time_s
        self.cap_dps = cap_dpm / 60.0
        self.tau_s = tau_s
        self.reset()

    def reset(self):
        self.offset_deg = 0.0          # accumulated heading correction
        self.pending_deg = 0.0         # heading change seen while still, not yet absorbed
        self.rate_dps = 0.0            # learned drift rate (deg/s)
        self.rate_weight_s = 0.0       # still time behind the estimate (for fast start-up)
        self.up = None                 # world vertical (unit), from gravity
        self.prev_q = None
        self.still_for = 0.0
        self.still = False

    def _learn_up(self, q, gravity):
        n = math.sqrt(sum(c * c for c in gravity))
        if n < 500:                    # ~0.5 g: no usable gravity in this block
            return
        m = ht.quat_to_mat(q)
        g = tuple(sum(m[i][k] * gravity[k] for k in range(3)) / n for i in range(3))
        if self.up is None:
            self.up = g
        else:
            a = 0.002
            self.up = ht.vnorm(tuple(u + a * (v - u) for u, v in zip(self.up, g)))

    def update(self, q, gyro_dps, gravity, dt):
        """Return the corrected quaternion (or q unchanged when disabled / not ready)."""
        if q is None:
            return None
        self._learn_up(q, gravity)
        if not self.enabled or self.up is None or dt <= 0 or dt > 0.25:
            self.prev_q = q
            return self._apply(q)

        wmag = math.sqrt(sum(c * c for c in gyro_dps))
        self.still_for = self.still_for + dt if wmag < self.still_dps else 0.0
        self.still = self.still_for >= self.still_time_s

        if self.prev_q is not None:
            # Heading change of the raw quaternion. One Q15 step is ~0.35 deg/s at 100 Hz while drift
            # is ~0.03 deg/s, so per-sample rates are mostly quantisation noise: integrate them
            # unclipped into `pending` and release that at no more than cap_dps.
            step = twist_deg(self.prev_q, q, self.up)
            if self.still:
                # pending only grows while still; more than pending_max_deg is real slow motion, not drift
                self.pending_deg = max(-self.pending_max_deg, min(self.pending_max_deg, self.pending_deg + step))
                lim = self.cap_dps * dt                 # the cap bounds the TOTAL correction while still
                move = max(-lim, min(lim, self.pending_deg))
                self.pending_deg -= move
                self.offset_deg += move
                # train the drift-rate estimate on what was absorbed while still
                # (fast at first, then time constant tau_s of still time)
                self.rate_weight_s = min(self.rate_weight_s + dt, self.tau_s)
                k = dt / self.rate_weight_s
                self.rate_dps += k * (move / dt - self.rate_dps)
            else:
                self.offset_deg += self.rate_dps * dt
        self.prev_q = q
        return self._apply(q)

    def _apply(self, q):
        if self.up is None or self.offset_deg == 0.0:
            return q
        r = qmul(axis_quat(self.up, -self.offset_deg), q)
        return r if r[0] >= 0 else tuple(-c for c in r)

    @property
    def rate_dpm(self):
        return self.rate_dps * 60.0
