#!/usr/bin/env python3
"""AirPodsGyro desktop app: AirPods head tracking for racing and flight sims.

    python airpodsgyro/app.py              (needs PySide6, see requirements.txt)
    python airpodsgyro/app.py --minimized  start in the tray
"""

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)


def main():
    from PySide6.QtCore import QLockFile, QDir
    from PySide6.QtWidgets import QApplication, QMessageBox

    from gui.config import config_dir
    from gui.main_window import MainWindow

    app = QApplication(sys.argv)
    app.setApplicationName("AirPodsGyro")
    app.setQuitOnLastWindowClosed(False)          # keeps running in the tray
    if sys.platform == "win32":
        app.setStyle("windows11") if "windows11" in [s.lower() for s in __import__(
            "PySide6.QtWidgets", fromlist=["QStyleFactory"]).QStyleFactory.keys()] else None

    lock = QLockFile(QDir(config_dir()).filePath("app.lock"))
    if not lock.tryLock(100):
        QMessageBox.information(None, "AirPodsGyro", "AirPodsGyro is already running (see the tray).")
        return 0

    win = MainWindow(app)
    if "--minimized" not in sys.argv:
        win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
