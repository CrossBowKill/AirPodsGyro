#!/usr/bin/env python3
"""AirPodsGyro desktop app: AirPods head tracking for racing and flight sims.

    python airpodsgyro/app.py              (needs PySide6, see requirements.txt)
    python airpodsgyro/app.py --minimized  start in the tray
    AirPodsGyro.exe --selftest out.json    check a packaged build (files, shared memory, DLL, Qt)
"""

import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)


def selftest(out_path):
    """Exercise everything a frozen build can get wrong (paths, DLLs, Qt plugins) without hardware."""
    import ctypes
    import math
    import traceback

    res = {"frozen": bool(getattr(sys, "frozen", False)), "checks": {}}

    def check(name, fn):
        try:
            res["checks"][name] = {"ok": True, "info": fn()}
        except Exception:
            res["checks"][name] = {"ok": False, "info": traceback.format_exc(limit=3)}

    from outputs import freetrack as ft

    def vendor():
        need = ["NPClient.dll", "NPClient64.dll", "freetrackclient.dll", "freetrackclient64.dll", "TrackIR.exe",
                os.path.join("settings", "facetracknoir supported games.csv"), "OPENTRACK-LICENSING.txt"]
        missing = [n for n in need if not os.path.exists(os.path.join(ft.VENDOR, n))]
        assert not missing, f"missing in {ft.VENDOR}: {missing}"
        return ft.VENDOR

    def games():
        g = ft.load_games()
        assert g.get(14101, ("",))[0] == "iRacing" and 8151 in g
        return f"{len(g)} games"

    def npclient():
        class Tir(ctypes.Structure):
            _fields_ = [("status", ctypes.c_short), ("frame", ctypes.c_short), ("cksum", ctypes.c_uint),
                        ("roll", ctypes.c_float), ("pitch", ctypes.c_float), ("yaw", ctypes.c_float),
                        ("pad", ctypes.c_float * 12)]
        out = ft.FreeTrackOutput(register=False, dummy_trackir=False)
        try:
            dll = ctypes.WinDLL(os.path.join(ft.VENDOR, "NPClient64.dll"))
            dll.NP_RegisterProgramProfileID(14101)
            out.send(15.0, 0.0, 0.0)
            out.send(15.0, 0.0, 0.0)
            t = Tir()
            dll.NP_GetData(ctypes.byref(t))
            want = math.radians(15.0) * 16383 / math.pi
            assert abs(t.yaw - want) < 0.5, (t.yaw, want)
            return f"game={out.game_name!r} yaw={t.yaw:.1f}"
        finally:
            out.close()

    def core():
        from core import protocol
        from core.pipeline import Pipeline, Settings  # noqa: F401
        blk = protocol.encode_block(1, (1.22, 0, 0), (0, 0, 1000), (1.0, 0, 0, 0))
        assert protocol.motion_blocks(protocol.encode_wx_packet([blk])) == [blk]
        return "ok"

    def qt():
        from PySide6.QtWidgets import QApplication
        from gui.widgets import HeadView, app_icon
        app = QApplication.instance() or QApplication(["selftest"])
        w = HeadView()
        w.resize(600, 220)
        w.set_angles((10.0, -5.0, 3.0))
        img = w.grab().toImage()
        assert not app_icon().isNull() and img.width() == 600
        from PySide6.QtCore import QLibraryInfo
        return QLibraryInfo.path(QLibraryInfo.LibraryPath.PluginsPath)

    for name, fn in (("vendor_files", vendor), ("games_list", games), ("core", core),
                     ("npclient_reads_shared_memory", npclient), ("qt", qt)):
        check(name, fn)
    res["ok"] = all(c["ok"] for c in res["checks"].values())
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(res, f, indent=2)
    return 0 if res["ok"] else 1


def main():
    if "--selftest" in sys.argv:
        i = sys.argv.index("--selftest")
        return selftest(sys.argv[i + 1] if i + 1 < len(sys.argv) else "selftest.json")
    from PySide6.QtCore import QDir, QLockFile
    from PySide6.QtWidgets import QApplication, QMessageBox, QStyleFactory

    from gui.config import config_dir
    from gui.main_window import MainWindow

    app = QApplication(sys.argv)
    app.setApplicationName("AirPodsGyro")
    app.setQuitOnLastWindowClosed(False)          # keeps running in the tray
    styles = {s.lower(): s for s in QStyleFactory.keys()}
    if "windows11" in styles:
        app.setStyle(styles["windows11"])

    lock = QLockFile(QDir(config_dir()).filePath("app.lock"))
    if not lock.tryLock(100):
        QMessageBox.information(None, "AirPodsGyro", "AirPodsGyro is already running (see the tray).")
        return 0

    win = MainWindow(app)
    if "--minimized" not in sys.argv:
        win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
